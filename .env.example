ENVIRONMENT = "DEV" # Use "DEV" or "PROD"

HTTP_PORT = "8080"
HTTP_ALLOW_ORIGINS = "http://localhost:3000"
HTTP_ALLOW_METHODS = "OPTIONS,GET,POST,PUT,PATCH,DELETE"
HTTP_ALLOW_HEADERS = "Origin,Content-Type,Accept,Authorization"
HTTP_ALLOW_CREDENTIALS = 1
HTTP_MAX_AGE = 12

POSTGRES_DSN = "postgres://postgres:default@localhost:5432/lautarok_hexa?sslmode=disable"

JWT_SECRET = "my secret"

OAUTH2_GOOGLE_CLIENT_ID = "google_client_id"
OAUTH2_GOOGLE_CLIENT_SECRET = "google_oauth_client_secret"
OAUTH2_GOOGLE_REDIRECT_URL = "https://localhost:3000/auth/google-oauth2/callback"